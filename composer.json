{
    "name": "sugarcommerce/privacy",
    "description": "Answer a WordPress personal data export or erasure request: register a plugin's groups from arrays, leave out the columns a person must not be handed, find an address however JSON escaped it, and keep an audit trail that names nobody.",
    "homepage": "https://github.com/SugarCommerce/privacy",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "David Sherlock",
            "homepage": "https://arraypress.com/"
        }
    ],
    "keywords": [
        "wordpress",
        "privacy",
        "gdpr",
        "personal-data",
        "export",
        "erasure",
        "right-to-be-forgotten"
    ],
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.13.5",
        "wp-coding-standards/wpcs": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "SugarCommerce\\Privacy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCommerce\\Privacy\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "/tests/bootstrap.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "format": "phpcbf --standard=phpcs-format.xml.dist",
        "format:check": "phpcs --standard=phpcs-format.xml.dist"
    },
    "support": {
        "issues": "https://github.com/SugarCommerce/privacy/issues",
        "source": "https://github.com/SugarCommerce/privacy"
    }
}
